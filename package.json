{
  "name": "deckdeckdeco",
  "version": "10.1.0",
  "description": "DeckDeckDeco v10k: Smart Button profiles, virtual deck pages, editable assets and scripts for Ulanzi D200H.",
  "type": "module",
  "private": true,
  "scripts": {
    "setup:windows": "powershell -File scripts/install-windows.ps1",
    "install:ulanzi": "powershell -File scripts/install-windows.ps1 -SkipSdk",
    "demo:test": "node scripts/examples/fake-test.mjs",
    "demo:snippet": "node scripts/examples/generate-snippet.mjs",
    "demo:stt": "node scripts/examples/fake-stt.mjs --out .deckdeckdeco/transcript.txt",
    "demo:llm": "node scripts/examples/fake-llm.mjs --in .deckdeckdeco/transcript.txt --out .deckdeckdeco/response.txt",
    "demo:tts": "node scripts/examples/fake-tts.mjs --in .deckdeckdeco/response.txt",
    "demo:translate": "node scripts/examples/fake-translate.mjs --in .deckdeckdeco/transcript.txt --out .deckdeckdeco/translate-response.txt --to en",
    "check:syntax": "node --check plugin/app.js && node --check property-inspector/inspector.js"
  },
  "dependencies": {
    "ws": "^8.18.0"
  }
}